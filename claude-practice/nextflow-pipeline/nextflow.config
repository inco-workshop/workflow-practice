/*
 * 파이프라인 설정
 */

params {
    // 분석 대상 구조 목록
    input     = "${projectDir}/assets/structures.csv"

    // 중첩 기준이 되는 구조 (structures.csv의 name 값)
    reference = 'sotorasib'

    // pocket 접촉 기준 거리 (Angstrom)
    cutoff    = 4.5

    // 결과 출력 경로
    outdir    = 'results'
}

// 실습 환경에서는 로컬에 설치된 python을 사용한다
docker.enabled = false

manifest {
    name        = 'kras-structural-comparison'
    description = 'KRAS G12C inhibitor 구조 비교 (pocket residue + switch-II 변위)'
    version     = '0.1.0'
}
