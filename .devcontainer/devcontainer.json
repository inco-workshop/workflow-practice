//
// MAIN PRODUCTION DEVCONTAINER CONFIG
// Uses image that is pre-built and pushed to GitHub
// See .github/.devcontainer/devcontainer.json for build
//
{
    "name": "workflow-practice",
    "image": "ghcr.io/nextflow-io/training:2.3.0",
    "workspaceFolder": "/workspaces/workflow-practice",
    "remoteUser": "root",
    "remoteEnv": {
        // Nextflow installation version
        "NXF_HOME": "/workspaces/.nextflow",
        "NXF_EDGE": "0",
        "NXF_VER": "25.04.3",
        // Other env vars
        "HOST_PROJECT_PATH": "/workspaces/workflow-practice",
        "SHELL": "/bin/bash" // Ush bash
    },
    "secrets": {
        "ANTHROPIC_API_KEY": {
            "description": "Anthropic Console에서 발급한 API Key를 입력하세요."
        }
    },
    "onCreateCommand": "bash .devcontainer/setup.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "nf-core.nf-core-extensionpack",
                "anthropic.claude-code",
                "ms-python.python",
                "ms-python.vscode-pylance"
            ],
            // Use Python from conda
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python",
                // Dark theme for the workshop
                "workbench.colorTheme": "Default Dark Modern"
            },
            // Use bash
            "terminal.integrated.defaultProfile.linux": "bash"
        }
    }
}
