//
// 워크숍 실습 환경
//  - Nextflow 25.04.3 (nextflow-io/training 이미지)
//  - Claude Code (setup.sh에서 설치)
//  - ANTHROPIC_API_KEY (Codespace 생성 시 입력)
//
{
    "name": "workflow-practice",
    "image": "ghcr.io/nextflow-io/training:2.3.0",
    "workspaceFolder": "/workspaces/workflow-practice",
    "remoteUser": "root",
    "remoteEnv": {
        // Nextflow installation version
        "NXF_HOME": "/workspaces/.nextflow",
        "NXF_EDGE": "0",
        "NXF_VER": "25.04.3",
        // Other env vars
        "HOST_PROJECT_PATH": "/workspaces/workflow-practice",
        "SHELL": "/bin/bash" // Ush bash
    },
    "secrets": {
        "ANTHROPIC_API_KEY": {
            "description": "Anthropic Console에서 발급한 API Key를 입력하세요."
        }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "waitFor": "postCreateCommand",
    "customizations": {
        "vscode": {
            "extensions": [
                "nf-core.nf-core-extensionpack",
                "anthropic.claude-code",
                "ms-python.python",
                "ms-python.vscode-pylance",
                // HTML 결과물(3D 시각화 등) 미리보기용
                "ms-vscode.live-server"
            ],
            // Use Python from conda
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python",
                // Dark theme for the workshop
                "workbench.colorTheme": "Default Dark Modern"
            },
            // Use bash
            "terminal.integrated.defaultProfile.linux": "bash"
        }
    }
}
